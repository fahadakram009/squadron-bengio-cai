# Copy to .env (git-ignored) and fill in ONE provider. Never commit keys.
LLM_PROVIDER=anthropic          # anthropic | gemini | openai | mock
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides: ANTHROPIC_MODEL=claude-opus-5-5  GEMINI_MODEL=gemini-2.5-pro  OPENAI_MODEL=gpt-5
